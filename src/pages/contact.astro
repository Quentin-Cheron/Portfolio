---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import BrandIcon from "../components/BrandIcon.astro";

const methods = [
  {
    icon: "mail",
    brand: false,
    label: "Email",
    value: "quentin.cheron26200@gmail.com",
    href: "mailto:quentin.cheron26200@gmail.com",
  },
  {
    icon: "linkedin",
    brand: true,
    label: "LinkedIn",
    value: "linkedin.com/in/quentin-cheron",
    href: "https://linkedin.com/in/quentin-cheron",
  },
  {
    icon: "github",
    brand: true,
    label: "GitHub",
    value: "github.com/qcheron",
    href: "https://github.com/qcheron",
  },
  {
    icon: "x",
    brand: true,
    label: "X (Twitter)",
    value: "x.com/qcheron",
    href: "https://x.com/qcheron",
  },
] as const;
---

<Layout title="Contact">
  <Nav current="contact" />

  <main class="flex flex-col items-center px-16 pb-24 pt-16">
    <div class="reveal flex w-[620px] flex-col gap-12">
      <div class="flex flex-col gap-4">
        <span class="font-mono text-sm text-[var(--accent)]">04 · Contact</span>
        <h1 class="font-heading text-[44px] font-semibold text-[var(--text-primary)]">Contact</h1>
        <p class="font-body text-base leading-[1.6] text-[var(--text-secondary)]">
          Disponible pour échanger sur des sujets backend et systèmes, ou discuter d'une opportunité. Le plus simple
          reste un email — je réponds sous quelques jours.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        {
          methods.map((method) => (
            <a
              href={method.href}
              target="_blank"
              rel="noreferrer"
              class="group flex items-center gap-4 rounded-[10px] border border-[var(--border)] bg-[var(--bg-elevated)] px-5 py-4 transition-colors duration-150 hover:border-[var(--border-strong)] hover:bg-[var(--bg-subtle)]"
            >
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--accent-dim)]">
                {method.brand ? (
                  <BrandIcon name={method.icon} class="h-5 w-5 text-[var(--accent)]" />
                ) : (
                  <Icon name={method.icon} class="h-5 w-5 text-[var(--accent)]" />
                )}
              </div>
              <div class="flex flex-1 flex-col gap-0.5">
                <span class="font-body text-sm font-medium text-[var(--text-muted)]">{method.label}</span>
                <span class="font-mono text-[15px] text-[var(--text-primary)]">{method.value}</span>
              </div>
              <Icon
                name="arrow-up-right"
                class="h-[18px] w-[18px] text-[var(--text-muted)] transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-[var(--accent)]"
              />
            </a>
          ))
        }
      </div>

      <Button href="mailto:quentin.cheron26200@gmail.com" variant="accent" class="w-fit">
        Envoyer un email
      </Button>
    </div>
  </main>

  <Footer />
</Layout>
