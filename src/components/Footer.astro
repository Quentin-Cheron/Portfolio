---
const links = [
  { label: "Email", href: "mailto:quentin.cheron26200@gmail.com" },
  { label: "LinkedIn", href: "https://linkedin.com/in/quentin-cheron" },
  { label: "GitHub", href: "https://github.com/qcheron" },
  { label: "X", href: "https://x.com/qcheron" },
];
---

<footer
  class="flex items-center justify-between px-16 py-9 bg-[var(--bg-elevated)] border-t border-[var(--border)]"
>
  <div class="flex flex-col gap-1.5">
    <span class="font-heading text-[15px] font-medium text-[var(--text-primary)]">Quentin Chéron</span>
    <span class="font-body text-[13px] text-[var(--text-muted)]">Développeur Full-Stack · Lyon</span>
  </div>
  <div class="flex items-center gap-7">
    {
      links.map((link) => (
        <a href={link.href} class="font-mono text-[13px] text-[var(--text-secondary)]" target="_blank" rel="noreferrer">
          {link.label}
        </a>
      ))
    }
  </div>
</footer>
